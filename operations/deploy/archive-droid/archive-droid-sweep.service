[Unit]
Description=Archive Droid nightly reconcile sweep: wiki files x registry x captures x links (read-only, #1360)
RequiresMountsFor=/opt/swccg-operations /mnt/HC_Volume_107153504
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/swccg-operations/operations/archive_droid/collect.py sweep
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
ReadWritePaths=/mnt/HC_Volume_107153504/work/archive-droid /mnt/HC_Volume_107153504/archive-droid-view
WorkingDirectory=/opt/swccg-operations
Nice=10
IOSchedulingClass=idle
MemoryMax=600M
